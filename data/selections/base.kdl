selection name="base" summary="Base system" description="The base system for all AerynOS installations." {
    packages {
        bash
        dash
        moss
        sudo
        bzip2
        ca-certificates
        curl
        dbus-broker
        diffutils
        dracut
        file
        findutils
        gawk
        grep
        gzip
        kmod
        less
        linux-pam
        lvm2
        nano
        ncurses
        ntpd-rs
        procps
        sed
        shadow
        systemd
        systemd-boot
        systemd-coredump
        systemd-preset-aeryn
        systemd-resolved
        systemd-udev
        tar
        tzdata
        unzip
        util-linux
        uutils-coreutils
        vim
        which
        xz
        zstd
    }
}
