selection name="base" summary="Base system" description="The base system for all AerynOS installations." {
    packages {
        "binary(bash)"
        "binary(dash)"
        "binary(file)"
        "binary(find)"
        "binary(gawk)"
        "binary(grep)"
        "binary(gzip)"
        "binary(less)"
        "binary(moss)"
        "binary(nano)"
        "binary(ping)"
        "binary(ps)"
        "binary(screen)"
        "binary(sed)"
        "binary(setfont)"
        "binary(ssh)"
        "binary(sudo)"
        "binary(tar)"
        "binary(unzip)"
        "binary(wget)"
        "binary(which)"
        "sysbinary(fsck.exfat)"
        "sysbinary(fsck.ext4)"
        "sysbinary(fsck.f2fs)"
        "sysbinary(fsck.xfs)"
        "sysbinary(ip)"
        bash-completion
        ca-certificates
        dbus
        dbus-broker
        dmidecode
        hyperv-daemons
        pciutils
        pkgset-aeryn-base
        pkgset-aeryn-utilities
        pkgset-aeryn-virtual
        qemu-guest-agent
        shadow
        spice-vdagent
        systemd
        systemd-boot
        systemd-coredump
        systemd-preset-aeryn
        systemd-resolved
        systemd-udev
        tzdata
        usbutils
        util-linux
        uutils-coreutils
    }
}
