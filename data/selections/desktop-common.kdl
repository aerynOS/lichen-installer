selection name="desktop-common" summary="Desktop base" description="Common infrastructure for all desktop environments" {
	depends {
		base
	}
	packages {
	    "binary(firefox)"
	    "sysbinary(plymouthd)"
	    flatpak
	    font-hack
	    font-noto
	    font-noto-cjk
	    font-noto-emoji
	    liberation-fonts-ttf
	    scx-tools
	    system76-scheduler
	    pkgset-aeryn-base-desktop
	    zram-generator-defaults
	}
}
