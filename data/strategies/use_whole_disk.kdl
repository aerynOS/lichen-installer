strategy name="whole_disk_xfs" summary="Wipe and use entire disk" {
    // Find a disk with the given constraints and then label it
    // We may find "any disk"
    // The result is stored in "root_disk" (disk=..)
    find-disk "root_disk" {
        constraints {
            min (GiB)30
        }
    }

    // Create a partition table. Defaults to GPT
    create-partition-table type="gpt" disk="root_disk"
    
    // 256 MiB ESP plus 3840 MiB XBOOTLDR is a flat 4 GiB of boot space, fixed
    // rather than ranged so every install has identical room for several
    // kernels and initrds regardless of disk size.

    // Create the ESP
    create-partition disk="root_disk" role="boot" id="esp" {
        constraints {
            exactly (MiB)256
        }
        type (GUID)"efi-system-partition"
        filesystem {
            type "fat32"
            label "ESP"
        }
    }

    // Create xbootldr
    create-partition disk="root_disk" role="extended-boot" id="xbootldr" {
        constraints {
            exactly (MiB)3840
        }
        type (GUID) "linux-extended-boot"
        filesystem {
            type "fat32"
            label "XBOOTLDR"
        }
    }

    // Create a partition for rootfs
    create-partition disk="root_disk" id="root" role="root" {
        constraints {
            min (GiB)25
        }
        type (GUID)"linux-fs"
        filesystem {
            type "xfs"
            label "ROOT"
        }
    }
}

